{
  "permissions": {
    "deny": [
      "Edit(./data/raw/**)",
      "Read(./.env)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_data.py\""
          }
        ]
      }
    ]
  }
}
